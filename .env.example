MODEL_BUNDLE_URI=gs://nuclei-lenses/flash-model/india_lightning_24h_demo_ed5dec2770f7.zip
MODEL_BUNDLE_SHA256=0b565c63f89be15818920ab6798a46530b0e0cbdfffd6c4a5b7c8dbacf7a39d1
ASSET_ROOT=/tmp/india-lightning-assets
OUTPUT_DIR=/tmp/india-lightning-output
AUTO_BOOTSTRAP_ASSETS=1

# Google Workload Identity Federation settings for Vercel keyless access.
# These values are non-secret configuration variables.
GCP_PROJECT_ID=data-mines
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=theflash-vercel@data-mines.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Optional legacy service account JSON (only if Workload Identity Federation is not used)
# GCP_SERVICE_ACCOUNT_JSON=

RECURSIVE_MODE=1
FORECAST_HORIZONS=4
DEFAULT_FORECAST_MODE=lightning_only_today
# Optional current lightning seed. When omitted, the app clearly labels the
# bundled historical seed as a time-rebased candidate rather than live input.
# LIGHTNING_HISTORY_PARQUET=/absolute/path/recent_lightning_history.parquet
# Or point at an object updated by the lightning-ingestion job. The backend
# downloads it privately at each requested forecast.
# LIGHTNING_HISTORY_URI=gs://nuclei-lenses/flash-model/latest_lightning_history.parquet
AUTO_RUN_FORECAST=1
HOST=0.0.0.0
PORT=8080
